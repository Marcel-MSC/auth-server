<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>Auth API - Documentation</title>
</head>

<body>
  <h1>Welcome to the Auth API</h1>
  <p>Available endpoints:</p>
  <ul>
    <li>
      <strong>POST /create-user</strong> - Create user<br>
      <em>Body (JSON):</em>
      <pre>{
  "email": "user@example.com",
  "password": "yourPassword"
}</pre>
      <em>Response (201):</em>
      <pre>{
  "message": "User created successfully!"
}</pre>
    </li>
    <li>
      <strong>POST /auth</strong> - Authenticate user<br>
      <em>Body (JSON):</em>
      <pre>{
  "email": "user@example.com",
  "password": "yourPassword"
}</pre>
      <em>Response (200):</em>
      <pre>{
  "message": "authentication success",
  "token": "&lt;jwt_token&gt;"
}</pre>
    </li>
    <li>
      <strong>POST /verify</strong> - Verify token<br>
      <em>Header:</em>
      <pre>Authorization: Bearer &lt;your_jwt_token&gt;</pre>
      <em>Response (200):</em>
      <pre>{
  "status": "logged in",
  "message": "verify with success"
}</pre>
    </li>
    <li>
      <strong>GET /check-account?email=user@example.com</strong> - Check if user exists<br>
      <em>Query:</em>
      <pre>?email=user@example.com</pre>
      <em>Response (200):</em>
      <pre>{
  "status": "User exists",
  "userExists": true
}</pre>
    </li>
    <li>
      <strong>DELETE /remove-user</strong> - Remove user<br>
      <em>Body (JSON):</em>
      <pre>{
  "email": "user@example.com"
}</pre>
      <em>Response (200):</em>
      <pre>{
  "status": "User removed",
  "userExists": true
}</pre>
    </li>
  </ul>
  <footer>
    <p>Version: <%= version %></p>
  </footer>
</body>

</html>
